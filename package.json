{
  "name": "chooseyourteam",
  "version": "0.0.5",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start -c",
    "postinstall": "setup-skia-web",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android -c",
    "ios": "expo start --ios -c",
    "web": "expo start --web -c",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --strict --typescript",
    "i18n:check": "node ./scripts/check-i18n-catalogs.mjs",
    "verify": "npm run typecheck && npm run lint && npm run i18n:check && npm test"
  },
  "expo": {
    "install": {
      "exclude": [
        "@shopify/react-native-skia"
      ]
    }
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.1",
    "@expo/ui": "~57.0.11",
    "@expo/vector-icons": "^15.1.1",
    "@formatjs/intl-getcanonicallocales": "^3.2.11",
    "@formatjs/intl-locale": "^5.3.10",
    "@formatjs/intl-pluralrules": "^6.3.13",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@lingui/core": "^6.6.0",
    "@lingui/react": "^6.6.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.10.0",
    "expo": "~57.0.13",
    "expo-asset": "~57.0.7",
    "expo-audio": "~57.0.3",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.13",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.2",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.14",
    "expo-web-browser": "~57.0.2",
    "heroui-native": "^1.0.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "uniwind": "1.2.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@lingui/babel-plugin-lingui-macro": "^6.6.0",
    "@lingui/cli": "^6.6.0",
    "@types/react": "~19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "private": true
}
