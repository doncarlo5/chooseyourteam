{
  "expo": {
    "name": "Choose Your Team",
    "slug": "chooseyourteam",
    "version": "0.0.7",
    "orientation": "portrait",
    "scheme": "chooseyourteam",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.doncarlos.chooseyourteam",
      "appStoreUrl": "https://apps.apple.com/app/id6756816697",
      "icon": {
        "dark": "./assets/images/ios-dark.png",
        "light": "./assets/images/ios-light.png",
        "tinted": "./assets/images/ios-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.doncarlos.chooseyourteam",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-audio",
      "expo-web-browser",
      "expo-asset",
      "expo-image",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "fr"],
            "android": ["en", "fr"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "92bc508c-3637-455c-95f3-aa98c12d68bc"
      }
    }
  }
}
